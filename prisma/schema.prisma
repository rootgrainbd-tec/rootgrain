// This is the primary Prisma schema file.
// It will compile models and enums from the respective directories to maintain modularity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Assumption: Postgres for standard deployment, adaptable per adapter
  url      = env("DATABASE_URL")
}

