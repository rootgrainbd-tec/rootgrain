generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id           String      @id @default(cuid())
  sanityId     String?     @unique
  name         String
  slug         String      @unique
  category     String
  price        Int
  comparePrice Int?
  wood         String
  dimensions   String
  image        String
  description  String
  shippingType String?
  inStock      Boolean     @default(true)
  isActive     Boolean     @default(true)
  featured     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]

  @@index([featured])
}

model Order {
  id              String               @id @default(cuid())
  orderNumber     String               @unique
  userId          String?
  subtotal        Int
  shippingCost    Int
  total           Int
  requiredAdvance   Int                  @default(0)
  legacyAdvancePaid Int                  @default(0)
  advancePaid       Int                  @default(0)
  balanceDue        Int
  status          OrderStatus          @default(PENDING_ADVANCE)
  productionState ProductionState      @default(NOT_STARTED)
  deliveryState   DeliveryState        @default(TBD)
  shippingAddress Json
  promoCode       String?
  discountAmount  Int                  @default(0)
  notes           String?
  logistics       LogisticsProvider    @default(PRIVATE_FREIGHT)
  trackingState   TrackingState        @default(PENDING_PRODUCTION)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  guestTokenHash  String?              @unique
  user            User?                @relation(fields: [userId], references: [id])
  items           OrderItem[]
  paymentRecords  PaymentRecord[]
  events                 OrderEvent[]
  documents              OrderDocument[]
  outboxItems            NotificationOutbox[]
  paymentReferenceClaims PaymentReferenceClaim[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Int
  total       Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product     Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model PaymentRecord {
  id           String        @id @default(cuid())
  orderId      String
  type         PaymentType
  method       PaymentMethod
  amount       Int
  status       PaymentStatus @default(INITIATED)
  reference    String?
  paidAt       DateTime?
  recordedById String?
  createdAt    DateTime      @default(now())
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, type])
  @@index([status])
}

model PaymentReferenceClaim {
  reference String
  method    PaymentMethod
  orderId   String
  createdAt DateTime      @default(now())
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@id([method, reference])
  @@index([orderId])
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  location  String
  piece     String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([approved])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id             String           @id @default(cuid())
  name           String
  email          String           @unique
  phone          String?
  role           Role             @default(USER)
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?
  failedAttempts Int              @default(0)
  lockedUntil    DateTime?
  passwordHash   String?
  image          String?
  updatedAt      DateTime         @updatedAt
  emailVerified  DateTime?
  abandonedCarts AbandonedCart[]
  accounts       Account[]
  addresses      Address[]
  AuditLog       AuditLog[]
  LoginAuditLog  LoginAuditLog[]
  orders         Order[]
  reviews        Review[]
  sessions       Session[]
  UserPermission UserPermission[]
  UserRole       UserRole[]
  wishlists      Wishlist[]
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  division  String
  district  String
  street    String
  postCode  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  message   String
  productId String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingRate {
  id          String   @id @default(cuid())
  district    String   @unique
  baseRate    Int
  perItemRate Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShippingTypeRate {
  id             String   @id @default(cuid())
  shippingType   String   @unique
  baseRate       Int
  additionalRate Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([status])
}

model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int
  isActive      Boolean      @default(true)
  maxUses       Int?
  currentUses   Int          @default(0)
  expiryDate    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([code])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model StoreSettings {
  id                           String   @id @default(cuid())
  abandonedCartDelayHours      Int      @default(24)
  abandonedCartDiscountPercent Int      @default(5)
  maintenanceMode              Boolean  @default(false)
  updatedAt                    DateTime @updatedAt
}

model AbandonedCart {
  id                 String              @id @default(cuid())
  email              String
  cartItems          Json
  lastActive         DateTime            @default(now())
  status             AbandonedCartStatus @default(PENDING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cartSessionId      String?             @unique
  isRecoveryEligible Boolean             @default(false)
  userId             String?
  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([status])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String   @unique
}

model AuditLog {
  id                String   @id
  userId            String?
  action            String
  resource          String
  principal         String
  decision          String
  eventHash         String   @unique
  previousEventHash String?  @unique
  metadata          Json?
  createdAt         DateTime @default(now())
  User              User?    @relation(fields: [userId], references: [id])

  @@index([userId, resource, createdAt])
}

model AuthRole {
  id             String           @id
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  RolePermission RolePermission[]
  UserRole       UserRole[]
}

model FeatureFlag {
  key         String   @id
  isActive    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model LoginAuditLog {
  id              String              @id
  userId          String?
  email           String
  timestamp       DateTime            @default(now())
  ipAddress       String
  userAgent       String
  deviceType      String?
  browser         String?
  operatingSystem String?
  authMethod      String
  success         Boolean
  failureReason   LoginFailureReason?
  sessionId       String?
  User            User?               @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([timestamp])
  @@index([userId])
}

model Permission {
  id             String           @id
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  RolePermission RolePermission[]
  UserPermission UserPermission[]
}

model Policy {
  id          String           @id
  name        String           @unique
  description String?
  effect      PermissionEffect
  rules       Json
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime

  @@index([isActive])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  Permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  AuthRole     AuthRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
}

model UserPermission {
  userId       String
  permissionId String
  effect       PermissionEffect @default(ALLOW)
  createdAt    DateTime         @default(now())
  Permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  User         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([userId])
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  AuthRole  AuthRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING_ADVANCE
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
  REJECTED
}

enum PaymentType {
  ADVANCE
  INSTALLMENT
  COD
}

enum ProductionState {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum DeliveryState {
  TBD
  FINALIZED
  OUT_FOR_DELIVERY
  DELIVERED_AND_COLLECTED
}

enum PaymentMethod {
  MANUAL_BKASH
  BANK_TRANSFER
  COD
  CASH
  OTHER
}

enum PaymentStatus {
  INITIATED
  COMPLETED
  FAILED
  REFUNDED
}

enum LogisticsProvider {
  PRIVATE_FREIGHT
  PATHAO
  REDX
  DHL
}

enum TrackingState {
  PENDING_PRODUCTION
  IN_PRODUCTION
  QUALITY_CHECK
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED_AND_COLLECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum AbandonedCartStatus {
  PENDING
  RECOVERED
  EMAIL_SENT
}

// AuthProvider enum removed

enum LoginFailureReason {
  INVALID_CREDENTIALS
  ACCOUNT_LOCKED
  OAUTH_STATE_MISMATCH
  OAUTH_REJECTED
  MISSING_IDENTITY
}

enum PermissionEffect {
  ALLOW
  DENY
  OBFUSCATE
  MASK
}

enum IdempotencyOwnerType {
  USER
  GUEST
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum NotificationOutboxStatus {
  PENDING
}

model IdempotencyKey {
  ownerType       IdempotencyOwnerType
  ownerId         String
  scope           String
  key             String
  fingerprint     String
  status          IdempotencyStatus    @default(IN_PROGRESS)
  resultReference String?
  responsePayload Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([ownerType, ownerId, scope, key])
}

model OrderEvent {
  id                 String               @id @default(cuid())
  orderId            String
  sequence           Int
  eventType          String
  payload            Json
  actor              Json
  occurredAt         DateTime             @default(now())
  order              Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  NotificationOutbox NotificationOutbox[]

  @@unique([orderId, sequence])
  @@index([orderId])
}

model OrderDocument {
  id                String   @id @default(cuid())
  orderId           String
  documentType      String
  referenceIdentity String
  snapshot          Json
  templateVersion   String
  createdBy         String
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model NotificationOutbox {
  id               String                   @id @default(cuid())
  eventReference   String
  orderId          String
  notificationType String
  channel          String
  status           NotificationOutboxStatus @default(PENDING)
  attempts         Int                      @default(0)
  lastError        String?                  @db.Text
  nextAttemptAt    DateTime?
  processedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  event            OrderEvent               @relation(fields: [eventReference], references: [id], onDelete: Restrict)
  order            Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([eventReference, notificationType, channel])
  @@index([eventReference])
  @@index([orderId])
  @@index([status])
}
