generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Product {
  id                         String      @id @default(cuid())
  sanityId                   String?     @unique
  name                       String
  slug                       String      @unique
  category                   String
  price                      Int
  comparePrice               Int?
  wood                       String
  dimensions                 String
  image                      String
  description                String
  inStock                    Boolean     @default(true)
  isActive                   Boolean     @default(true)
  featured                   Boolean     @default(false)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt
  shippingType               String?
  isMto                      Boolean     @default(false)
  baseLeadTimeDays           Int         @default(30)
  additionalUnitLeadTimeDays Int         @default(10)
  orderItems                 OrderItem[]

  @@index([featured])
}

model Order {
  id                         String                  @id @default(cuid())
  orderNumber                String                  @unique
  userId                     String?
  subtotal                   Int
  shippingCost               Int
  total                      Int
  advancePaid                Int                     @default(0)
  balanceDue                 Int
  status                     OrderStatus             @default(PENDING_ADVANCE)
  shippingAddress            Json
  promoCode                  String?
  discountAmount             Int                     @default(0)
  notes                      String?
  logistics                  LogisticsProvider       @default(PRIVATE_FREIGHT)
  trackingState              TrackingState           @default(PENDING_PRODUCTION)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  guestTokenHash             String?                 @unique
  deliveryState              DeliveryState           @default(TBD)
  productionState            ProductionState         @default(NOT_STARTED)
  requiredAdvance            Int                     @default(0)
  legacyAdvancePaid          Int                     @default(0)
  isMtoOrder                 Boolean                 @default(false)
  advanceDeadline            DateTime?
  estimatedManufacturingDays Int?
  estimatedCompletionDate    DateTime?
  trackingNumber             String?
  trackingUrl                String?
  internalNotes              AdminInternalNote[]
  customRequest              CustomRequest?
  outboxItems                NotificationOutbox[]
  user                       User?                   @relation(fields: [userId], references: [id])
  documents                  OrderDocument[]
  events                     OrderEvent[]
  items                      OrderItem[]
  paymentRecords             PaymentRecord[]
  paymentReferenceClaims     PaymentReferenceClaim[]
  priceRevisions             PriceRevision[]
  qualityInspections         QualityInspection[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                  String          @id @default(cuid())
  orderId             String
  productId           String?
  productName         String
  quantity            Int
  unitPrice           Int
  total               Int
  customSpecification String?
  order               Order           @relation(fields: [orderId], references: [id])
  product             Product?        @relation(fields: [productId], references: [id])
  priceRevisions      PriceRevision[]

  @@index([orderId])
  @@index([productId])
}

model PaymentRecord {
  id                String         @id @default(cuid())
  orderId           String
  type              PaymentType
  method            PaymentMethod
  amount            Int
  status            PaymentStatus  @default(INITIATED)
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  recordedById      String?
  reference         String?
  invoiceDocumentId String?
  invoiceDocument   OrderDocument? @relation(fields: [invoiceDocumentId], references: [id], onDelete: Restrict)
  order             Order          @relation(fields: [orderId], references: [id])

  @@unique([orderId, type])
  @@index([status])
  @@index([invoiceDocumentId])
}

model PaymentReferenceClaim {
  reference String
  method    PaymentMethod
  orderId   String
  createdAt DateTime      @default(now())
  order     Order         @relation(fields: [orderId], references: [id])

  @@id([method, reference])
  @@index([orderId])
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  author    String
  location  String
  piece     String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([approved])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  provider          String
  type              String
  access_token      String?
  refresh_token     String?
  id_token          String?
  token_type        String?
  scope             String?
  session_state     String?
  expires_at        Int?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessionToken String   @unique
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  phone              String?
  role               Role                @default(USER)
  createdAt          DateTime            @default(now())
  deletedAt          DateTime?
  failedAttempts     Int                 @default(0)
  lockedUntil        DateTime?
  passwordHash       String?
  updatedAt          DateTime            @updatedAt
  emailVerified      DateTime?
  image              String?
  abandonedCarts     AbandonedCart[]
  accounts           Account[]
  addresses          Address[]
  LoginAuditLog      LoginAuditLog[]
  orders             Order[]
  reviews            Review[]
  sessions           Session[]
  permissions        UserPermission[]
  wishlists          Wishlist[]
  qualityInspections QualityInspection[]
}

model VerificationToken {
  token      String   @unique
  createdAt  DateTime @default(now())
  identifier String
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  division  String
  district  String
  street    String
  postCode  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  message   String
  productId String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingRate {
  id          String   @id @default(cuid())
  district    String   @unique
  baseRate    Int
  perItemRate Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShippingTypeRate {
  id             String   @id @default(cuid())
  shippingType   String   @unique
  baseRate       Int
  additionalRate Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([status])
}

model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Int
  isActive      Boolean      @default(true)
  maxUses       Int?
  currentUses   Int          @default(0)
  expiryDate    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([code])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model StoreSettings {
  id                           String   @id @default(cuid())
  abandonedCartDelayHours      Int      @default(24)
  abandonedCartDiscountPercent Int      @default(5)
  maintenanceMode              Boolean  @default(false)
  updatedAt                    DateTime @updatedAt
}

model AbandonedCart {
  id                 String              @id @default(cuid())
  email              String
  cartItems          Json
  lastActive         DateTime            @default(now())
  status             AbandonedCartStatus @default(PENDING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cartSessionId      String?             @unique
  isRecoveryEligible Boolean             @default(false)
  userId             String?
  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([status])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String   @unique
}

model LoginAuditLog {
  id              String              @id
  userId          String?
  email           String
  timestamp       DateTime            @default(now())
  ipAddress       String
  userAgent       String
  deviceType      String?
  browser         String?
  operatingSystem String?
  authMethod      String
  success         Boolean
  failureReason   LoginFailureReason?
  sessionId       String?
  User            User?               @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([timestamp])
  @@index([userId])
}

model IdempotencyKey {
  ownerType       IdempotencyOwnerType
  ownerId         String
  scope           String
  key             String
  fingerprint     String
  status          IdempotencyStatus    @default(IN_PROGRESS)
  resultReference String?
  responsePayload Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([ownerType, ownerId, scope, key])
}

model OrderEvent {
  id                 String               @id @default(cuid())
  orderId            String
  sequence           Int
  eventType          String
  payload            Json
  actor              Json
  occurredAt         DateTime             @default(now())
  NotificationOutbox NotificationOutbox[]
  order              Order                @relation(fields: [orderId], references: [id])

  @@unique([orderId, sequence])
  @@index([orderId])
}

model OrderDocument {
  id                String          @id @default(cuid())
  orderId           String
  documentType      String
  referenceIdentity String
  snapshot          Json
  templateVersion   String
  createdBy         String
  createdAt         DateTime        @default(now())
  status            String          @default("ISSUED")
  checksum          String?
  mimeType          String          @default("application/pdf")
  size              Int?
  storageKey        String?
  order             Order           @relation(fields: [orderId], references: [id])
  paymentRecords    PaymentRecord[]

  @@unique([documentType, referenceIdentity])
  @@index([orderId])
}

model NotificationOutbox {
  id               String                   @id @default(cuid())
  eventReference   String
  orderId          String
  notificationType String
  channel          String
  status           NotificationOutboxStatus @default(PENDING)
  attempts         Int                      @default(0)
  lastError        String?
  nextAttemptAt    DateTime?
  processedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  event            OrderEvent               @relation(fields: [eventReference], references: [id])
  order            Order                    @relation(fields: [orderId], references: [id])

  @@unique([eventReference, notificationType, channel])
  @@index([eventReference])
  @@index([orderId])
  @@index([status])
}

model AdminInternalNote {
  id        String   @id @default(cuid())
  orderId   String
  content   String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model CustomRequest {
  id                      String               @id @default(cuid())
  customerName            String
  mobileNumber            String
  email                   String?
  channel                 CustomRequestChannel
  status                  CustomRequestStatus  @default(SUBMITTED)
  subtotal                Int                  @default(0)
  deliveryCharge          Int                  @default(0)
  total                   Int                  @default(0)
  requiredAdvance         Int                  @default(0)
  estimatedCompletionDate DateTime?
  guestTokenHash          String?              @unique
  orderId                 String?              @unique
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  order                   Order?               @relation(fields: [orderId], references: [id])
  events                  CustomRequestEvent[]
  items                   CustomRequestItem[]

  @@index([mobileNumber])
  @@index([status])
  @@index([channel])
  @@index([createdAt])
}

model CustomRequestItem {
  id              String        @id @default(cuid())
  customRequestId String
  name            String
  quantity        Int           @default(1)
  designSpecs     String?
  dimensions      String?
  material        String?
  finish          String?
  notes           String?
  referenceImages Json?
  agreedUnitPrice Int?
  customRequest   CustomRequest @relation(fields: [customRequestId], references: [id], onDelete: Cascade)

  @@index([customRequestId])
}

model CustomRequestEvent {
  id              String        @id @default(cuid())
  customRequestId String
  sequence        Int
  eventType       String
  payload         Json?
  actor           Json
  occurredAt      DateTime      @default(now())
  customRequest   CustomRequest @relation(fields: [customRequestId], references: [id], onDelete: Cascade)

  @@unique([customRequestId, sequence])
  @@index([customRequestId])
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  roles       RolePermission[]
  users       UserPermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model PriceRevision {
  id                   String    @id @default(cuid())
  orderId              String
  orderItemId          String
  previousProductPrice Int
  adjustment           Int
  newProductPrice      Int
  reason               String
  actor                Json
  createdAt            DateTime  @default(now())
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem            OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orderItemId])
}

model QualityInspection {
  id           String                  @id @default(cuid())
  orderId      String
  status       QualityInspectionStatus
  notes        String?                 @db.Text
  evidenceKeys Json?
  inspectorId  String
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  order        Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inspector    User                    @relation(fields: [inspectorId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([inspectorId])
}

enum QualityInspectionStatus {
  PASS
  FAIL
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING_ADVANCE
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
  REJECTED
}

enum PaymentType {
  ADVANCE
  INSTALLMENT
  COD
}

enum ProductionState {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum DeliveryState {
  TBD
  FINALIZED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum PaymentMethod {
  MANUAL_BKASH
  BANK_TRANSFER
  COD
  CASH
  OTHER
}

enum PaymentStatus {
  INITIATED
  COMPLETED
  FAILED
  REFUNDED
  VOIDED
}

enum LogisticsProvider {
  PRIVATE_FREIGHT
  PATHAO
  REDX
  DHL
  STEADFAST
}

enum TrackingState {
  PENDING_PRODUCTION
  IN_PRODUCTION
  QUALITY_CHECK
  REWORK
  READY_FOR_DISPATCH
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum AbandonedCartStatus {
  PENDING
  RECOVERED
  EMAIL_SENT
}

enum LoginFailureReason {
  INVALID_CREDENTIALS
  ACCOUNT_LOCKED
  OAUTH_STATE_MISMATCH
  OAUTH_REJECTED
  MISSING_IDENTITY
}

enum IdempotencyOwnerType {
  USER
  GUEST
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum CustomRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  QUOTE_READY
  CUSTOMER_DECLINED
  CONVERTED
  CANCELLED
}

enum CustomRequestChannel {
  CUSTOMER_ONLINE
  ADMIN_OFFLINE
}
